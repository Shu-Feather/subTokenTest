{
  "benchmark_settings": {
    "results_dir": "results",
    "save_raw_responses": true,
    "save_detailed_results": true,
    "timeout_seconds": 30
  },
  "tasks": {
    "dna_complement": {
      "enabled": true,
      "num_cases": 100,
      "sequence_length_range": [
        8,
        20
      ],
      "description": "Generate complementary DNA sequences"
    },
    "rna_complement": {
      "enabled": true,
      "num_cases": 100,
      "sequence_length_range": [
        8,
        20
      ],
      "description": "Generate complementary RNA sequences"
    },
    "protein_three_to_one": {
      "enabled": true,
      "num_cases": 75,
      "sequence_length_range": [
        5,
        12
      ],
      "description": "Convert protein sequences from three-letter to one-letter codes"
    },
    "protein_one_to_three": {
      "enabled": true,
      "num_cases": 75,
      "sequence_length_range": [
        5,
        12
      ],
      "description": "Convert protein sequences from one-letter to three-letter codes"
    }
  },
  "models": {
    "gpt-3.5-turbo": {
      "provider": "openai",
      "model_name": "gpt-3.5-turbo",
      "parameters": {
        "temperature": 0.1,
        "max_tokens": 1024,
        "top_p": 1.0
      }
    },
    "gpt-4": {
      "provider": "openai",
      "model_name": "gpt-4",
      "parameters": {
        "temperature": 0.1,
        "max_tokens": 1024,
        "top_p": 1.0
      }
    },
    "deepseek-chat": {
      "provider": "deepseek_chat",
      "model_name": "deepseek-chat",
      "parameters": {
        "temperature": 0.1,
        "max_tokens": 1024,
        "system_message": "You are a helpful biology assistant with expertise in molecular biology and genetics."
      }
    },
    "deepseek-reasoner": {
      "provider": "deepseek_reasoning",
      "model_name": "deepseek-reasoner",
      "parameters": {
        "temperature": 0.1,
        "max_tokens": 8000,
        "return_reasoning_content": false
      }
    },
    "deepseek-r1": {
      "provider": "deepseek_reasoning",
      "model_name": "deepseek-r1",
      "parameters": {
        "temperature": 0.1,
        "max_tokens": 8000,
        "return_reasoning_content": true,
        "system_message": "You are an expert in biology. Think step by step to solve problems."
      }
    },
    "llama-3-8b-local": {
