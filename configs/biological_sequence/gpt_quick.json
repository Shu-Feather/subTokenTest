{
  "benchmark_settings": {
    "results_dir": "results",
    "save_raw_responses": true,
    "save_detailed_results": true,
    "timeout_seconds": 300
  },
  "tasks": {
    "dna_complement": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [8, 20],
      "description": "Generate complementary DNA sequences"
    },
    "rna_complement": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [8, 20],
      "description": "Generate complementary RNA sequences"
    },
    "protein_three_to_one": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [5, 12],
      "description": "Convert protein sequences from three-letter to one-letter codes"
    },
    "protein_one_to_three": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [5, 12],
      "description": "Convert protein sequences from one-letter to three-letter codes"
    }
  },
  "models": {
    "gpt-4": {
      "provider": "openai",
      "model_name": "gpt-4",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 6000,
        "timeout": 300
      }
    },
    "gpt-5": {
      "provider": "openai",
      "model_name": "gpt-5",
      "parameters": {
        "max_tokens": 30000,
        "timeout": 300
      }
    },
    "o4-mini": {
      "provider": "openai",
      "model_name": "o4-mini",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 30000,
        "timeout": 300,
        "reasoning_effort": "low"
      }
    }
  }
}