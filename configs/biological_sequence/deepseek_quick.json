{
  "benchmark_settings": {
    "results_dir": "results",
    "save_raw_responses": true,
    "save_detailed_results": true,
    "timeout_seconds": 30
  },
  "tasks": {
    "dna_complement": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [8, 20],
      "description": "Generate complementary DNA sequences"
    },
    "rna_complement": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [8, 20],
      "description": "Generate complementary RNA sequences"
    },
    "protein_three_to_one": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [5, 12],
      "description": "Convert protein sequences from three-letter to one-letter codes"
    },
    "protein_one_to_three": {
      "enabled": true,
      "num_cases": 10,
      "sequence_length_range": [5, 12],
      "description": "Convert protein sequences from one-letter to three-letter codes"
    }
  },
  "models": {
    "deepseek-v3": {
      "provider": "deepseek",
      "model_name": "deepseek-chat",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 4000
      }
    },
    "deepseek-r1": {
      "provider": "deepseek",
      "model_name": "deepseek-reasoner",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 10000,
        "timeout": 300
      }
    }
  }
}